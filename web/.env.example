# Copy to .env.local for `npm run dev`; set the same two in Vercel.
# Both are public by design: RLS limits each signed-in person to their own row.
# Never put the secret (sb_secret_...) key here or in Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Read by the Python preview function (web/api/preview.py, owned by the backend), not by Next.js.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
